# Telegram Bot credentials
# Get BOT_TOKEN from @BotFather on Telegram
# Get CHAT_ID by sending a message to your bot and opening:
#   https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# Optional tuning
# DAYS_AHEAD=45       # how many days ahead to check
# MIN_DELAY=3         # minimum seconds between requests
# MAX_DELAY=8         # maximum seconds between requests
